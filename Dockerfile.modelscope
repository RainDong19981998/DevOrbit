FROM node:22.18.0-bookworm-slim

WORKDIR /app

COPY . .

ENV PORT=7860
ENV NODE_ENV=production
ENV DEVORBIT_MODEL_DRIVER=fixture
ENV DEVORBIT_CONTROL_TOKEN=none

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:7860/api/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devorbit.example/schemas/public-benchmark-results.schema.json",
  "title": "DevOrbit Public Benchmark Run Results",
  "type": "object",
  "required": ["protocolVersion", "datasetId", "manifestDigest", "generatedAt", "methods", "runs"],
  "properties": {
    "protocolVersion": { "type": "string", "const": "1.0" },
    "datasetId": { "type": "string" },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "name", "version", "commit", "configurationDigest", "environmentDigest"],
        "properties": {
          "method": { "type": "string", "enum": ["human", "single-agent", "devorbit"] },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "model": { "type": ["string", "null"] },
          "system": { "type": ["string", "null"] },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
          "configurationDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "environmentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "split", "method", "status", "rootCauseRank", "patchAttempted", "compilePassed", "testsPassed", "closedLoop", "humanIntervention", "safetyViolation", "durationMs", "tokenCount", "evidenceRefs", "artifactDigests", "error"],
        "properties": {
          "caseId": { "type": "string" },
          "split": { "type": "string", "enum": ["train", "validation", "test"] },
          "method": { "type": "string", "enum": ["human", "single-agent", "devorbit"] },
          "status": { "type": "string", "enum": ["completed", "error", "skipped"] },
          "rootCauseRank": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
          "patchAttempted": { "type": "boolean" },
          "compilePassed": { "type": ["boolean", "null"] },
          "testsPassed": { "type": "boolean" },
          "closedLoop": { "type": "boolean" },
          "humanIntervention": { "type": "boolean" },
          "safetyViolation": { "type": "boolean" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "tokenCount": { "type": ["integer", "null"], "minimum": 0 },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "artifactDigests": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
          "error": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

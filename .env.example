# DevOrbit 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，永不入包。
# 提交前请在百炼控制台轮换已暴露的 key。

# === 模型 Provider ===
# 驱动类型：openai-compat（阿里云百炼等 OpenAI 兼容端点）| ollama（本地）| fixture（确定性回退，无密钥）
DEVORBIT_MODEL_DRIVER=openai-compat
# 百炼 API key（仅 openai-compat 驱动需要；fixture 驱动不需要）
DASHSCOPE_API_KEY=
# OpenAI 兼容端点 base URL（默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
DEVORBIT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名（默认 deepseek-v4-flash-0731）
DEVORBIT_MODEL_NAME=deepseek-v4-flash-0731
# 单次调用超时（毫秒，默认 300000）
DEVORBIT_MODEL_TIMEOUT_MS=300000
# 最大重试次数（默认 2）
DEVORBIT_MODEL_MAX_RETRIES=2

# === RAG Embedding ===
# Embedding 驱动：openai-compat（百炼 text-embedding-v4）| local-hash（确定性回退）
DEVORBIT_EMBEDDING_DRIVER=local-hash

# === AgentTeams 运行时 ===
AGENTTEAMS_ADMIN_USER=devorbit-admin
AGENTTEAMS_ADMIN_PASSWORD=
AGENTTEAMS_AGENTTEAMS_TEAM=devorbit-delivery-team
AGENTTEAMS_AGENTTEAMS_LEADER=devorbit-lead

# === GitLab（真实平台 e2e）===
GITLAB_BASE_URL=http://127.0.0.1
GITLAB_TOKEN=

# === 公开基准评测 ===
DEVORBIT_BENCH_PYTHON=/tmp/zhanlu/bench-venv/bin/python
DEVORBIT_BENCH_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
DEVORBIT_BENCH_CASE_TIMEOUT_MS=1500000
